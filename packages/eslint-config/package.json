{
  "name": "@turtleby/eslint-config",
  "version": "0.0.0",
  "description": "Linting configuration for turtleby packages",
  "private": true,
  "type": "module",
  "types": "index.d.ts",
  "packageManager": "yarn@4.9.1",
  "exports": {
    ".": "./index.js",
    "./svelte": "./svelte.js"
  },
  "scripts": {
    "build": "tsc"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "prettier": "*",
    "svelte": "*",
    "typescript": "*"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@turtleby/typescript-config": "workspace:^",
    "@types/node": "^22.15.21",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-svelte": "^3.9.0",
    "globals": "^16.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  }
}

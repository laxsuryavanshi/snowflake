{
  "$schema": "../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "packages",
  "projects": {
    "watchtower": {
      "projectType": "library",
      "root": "packages/watchtower",
      "sourceRoot": "packages/watchtower/src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "packages/watchtower/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "packages/watchtower/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "packages/watchtower/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "packages/watchtower/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      }
    }
  }
}
